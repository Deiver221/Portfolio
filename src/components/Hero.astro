---
import AvailableBadge from "./AvailableBadge"
---

<section class="py-16 flex flex-col gap-4" id="hero">
  <div class="flex items-center gap-3">
    <img
      src="/me.webp"
      alt="Foto de perfil"
      class="w-14 h-14 rounded-full object-cover"
    />
    <AvailableBadge client:load />
  </div>

  <h1 class="text-5xl font-bold mt-2">
    <span id="hero-title"></span> <span class="text-yellow-400">Deiver</span>
  </h1>

  <p id="hero-description" class="text-gray-400 text-lg max-w-xl leading-relaxed"></p>

  <div class="flex gap-3 mt-2">
    <a
      href="#contacto"
      id="hero-contact"
      class="flex items-center gap-2 bg-white text-black font-medium px-4 py-2 rounded-full text-sm hover:bg-gray-200 transition-colors"
    ></a>
    <a
      href="https://www.linkedin.com/in/deiver-mata"
      target="_blank"
      class="flex items-center gap-2 border border-white/20 px-4 py-2 rounded-full text-sm text-gray-300 hover:border-white/50 hover:text-white transition-colors"
    >
      LinkedIn
    </a>
  </div>
</section>

<script>
  import { getLang, setLang } from "../i18n/utils"
  import { translations } from "../i18n/translations"
  import type { Language } from "../i18n/translations"

  function updateHero(lang: Language) {
    const t = translations[lang].hero
    document.getElementById("hero-title")!.textContent = t.title
    document.getElementById("hero-description")!.textContent = t.description
    document.getElementById("hero-contact")!.textContent = t.contact
  }

  updateHero(getLang())

  window.addEventListener("langchange", (e) => {
    updateHero((e as CustomEvent<Language>).detail)
  })
</script>