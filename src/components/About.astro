---
---

<section id="sobre-mi" class="py-16">
  <h2 class="text-2xl font-bold mb-6 flex items-center gap-2">
    <span class="text-yellow-400">👤</span>
    <span id="about-title"></span>
  </h2>

  <p id="about-p1" class="text-gray-400 leading-relaxed mb-6"></p>

  <div class="flex flex-col md:flex-row gap-8">
    <div class="flex flex-col gap-4 text-gray-400 leading-relaxed">
      <p id="about-p2"></p>
      <p id="about-p3"></p>
    </div>

    <img
      src="/me.webp"
      alt="Foto de perfil"
      class="w-full md:w-64 md:h-64 object-cover object-top shrink-0 grayscale hover:grayscale-0 transition-all duration-500 rounded-xl border border-white/10"
    />
  </div>
</section>

<script>
  import { getLang } from "../i18n/utils"
  import { translations } from "../i18n/translations"
  import type { Language } from "../i18n/translations"

  function updateAbout(lang: Language) {
    const t = translations[lang].about
    document.getElementById("about-title")!.textContent = t.title
    document.getElementById("about-p1")!.textContent = t.paragraphs[0]
    document.getElementById("about-p2")!.textContent = t.paragraphs[1]
    document.getElementById("about-p3")!.textContent = t.paragraphs[2]
  }

  updateAbout(getLang())

  window.addEventListener("langchange", (e) => {
    updateAbout((e as CustomEvent<Language>).detail)
  })
</script>