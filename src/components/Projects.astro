---
import ProjectCard from './ProjectCard.astro'
import { translations } from '../i18n/translations'

const projectsMeta = [
  {
    tags: ["Laravel", "Postgresql", "React", "Tailwind CSS"],
    image: "/projects/Car-Rental-Image.png",
    codeUrl: "https://github.com/Deiver221/carrental-frontend",
    previewUrl: "https://carrental-frontend-omega.vercel.app/",
  },
  {
    tags: ["Laravel", "Postgresql", "React", "Tailwind CSS"],
    image: "/projects/AI-Car-Finder-Image.png",
    codeUrl: "https://github.com/Deiver221/ai-car-finder-frontend",
    previewUrl: "https://ai-car-finder-frontend.vercel.app/",
  }
]

// Render inicial con inglés (predeterminado)
const initialLang = "en"
const initialTexts = translations[initialLang].projects
---

<section id="proyectos" class="py-16">
  <h2 class="text-3xl font-bold mb-2 flex items-center gap-2">
    <span class="text-yellow-400">{"</>"}</span>
    <span id="projects-title"></span>
  </h2>

  <div id="projects-list">
    {projectsMeta.map((meta, i) => (
      <ProjectCard
        {...meta}
        title={initialTexts.items[i].title}
        description={initialTexts.items[i].description as string[]}
        note={initialTexts.items[i].note}
        codeLabel={initialTexts.code}
        previewLabel={initialTexts.preview}
        noteLabel={initialTexts.note}
        index={i}
      />
    ))}
  </div>
</section>

<script>
  import { getLang } from "../i18n/utils"
  import { translations } from "../i18n/translations"
  import type { Language } from "../i18n/translations"

  function updateProjects(lang: Language) {
    const t = translations[lang].projects
    document.getElementById("projects-title")!.textContent = t.title

    t.items.forEach((item, i) => {
      const card = document.querySelector(`[data-project-index="${i}"]`)
      if (!card) return
      card.querySelector("[data-project-title]")!.textContent = item.title
      card.querySelectorAll("[data-project-desc]").forEach((p, j) => {
        p.textContent = item.description[j]
      })
      const noteEl = card.querySelector("[data-project-note]")
      if (noteEl) noteEl.textContent = item.note
      const noteLabelEl = card.querySelector("[data-note-label]")
      if (noteLabelEl) noteLabelEl.textContent = t.note + ":"
    })
  }

  updateProjects(getLang())

  window.addEventListener("langchange", (e) => {
    updateProjects((e as CustomEvent<Language>).detail)
  })
</script>